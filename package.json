{
  "name": "localloop-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "LocalLoop – Hyperlocal Second-Hand Marketplace",
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "dev:server": "npm --workspace=server run dev",
    "dev:client": "npm --workspace=client run dev",
    "dev": "npm --workspace=server run dev",
    "build:server": "npm --workspace=server run build",
    "build:client": "npm --workspace=client run build",
    "build": "npm run build:server && npm run build:client",
    "test": "npm --workspace=server run test"
  },
  "keywords": [
    "marketplace",
    "hyperlocal",
    "postgis",
    "react",
    "express",
    "socket.io",
    "razorpay"
  ],
  "author": "LocalLoop Team",
  "license": "ISC"
}

