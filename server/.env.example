# Server Environment Variables
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# Database (PostgreSQL + PostGIS)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/localloop
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=localloop

# Redis
REDIS_URL=redis://localhost:6379

# JWT Authentication
JWT_ACCESS_SECRET=localloop_super_secret_access_jwt_key_2026_xyz
JWT_REFRESH_SECRET=localloop_super_secret_refresh_jwt_key_2026_xyz
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Cloudinary (Optional - local fallback provided if empty)
CLOUDINARY_CLOUD_NAME=demo_cloud
CLOUDINARY_API_KEY=demo_key
CLOUDINARY_API_SECRET=demo_secret

# Razorpay (Test Mode)
RAZORPAY_KEY_ID=rzp_test_placeholder_key
RAZORPAY_KEY_SECRET=rzp_test_placeholder_secret
RAZORPAY_WEBHOOK_SECRET=rzp_webhook_secret_local

# Email (Nodemailer / SMTP)
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_USER=test@ethereal.email
SMTP_PASS=testpass
SMTP_FROM=LocalLoop <no-reply@localloop.market>

