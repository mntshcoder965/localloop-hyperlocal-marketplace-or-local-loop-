{
  "name": "localloop-server",
  "version": "1.0.0",
  "type": "module",
  "description": "Backend API for LocalLoop Hyperlocal Marketplace",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
